---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { DateTime } from 'luxon';
import SanityImage from '../components/common/SanityImage.astro';
import Layout from '../layouts/PageLayout.astro';

import Brands from '../components/widgets/Brands.astro';
import CallToAction from '../components/widgets/CallToAction.astro';
import Features from '../components/widgets/Features.astro';
import Hero from '../components/widgets/Hero.astro';
import Testimonials from '../components/widgets/Testimonials.astro';
import { fetchAll as fetchAllTestimonials } from '../queries/Testimonials';
import { fetchActive as fetchActiveSponsors } from '../queries/Sponsors';
import type { CallToAction as HeroCallToAction } from '../types';
import { isRegistrationOpen } from '../queries/Registration';
import { getFeaturedEvents } from '../queries/Events';
import { findLocalImage } from '../utils/images';

import WidgetWrapper from '../components/ui/WidgetWrapper.astro';

const hero = await findLocalImage('~/assets/images/brightstar-hero.jpg');

const metadata = {
  title: 'Twin Cities Homeschoolers for the Arts',
  ignoreTitleTemplate: true,
  description:
    'Performing arts classes and opportunities for home-educated students in the Minneapolis/St. Paul area—choir, dance, drama, lessons, and theatre.',
  openGraph: {
    images: [{ url: '~/assets/images/brightstar-hero.jpg', width: 1200, height: 630 }],
  },
};
const sponsors = await fetchActiveSponsors();
const testimonials = await fetchAllTestimonials();
const registrationIsOpen = await isRegistrationOpen();
const featuredEvent = (await getFeaturedEvents())[0];
const featuredEventImage = featuredEvent?.thumbnail ?? featuredEvent?.hero;
const featuredShow = featuredEvent?.related_entities.find((entity) => entity.type === 'show');
const heroActions: HeroCallToAction[] = [{ text: 'Learn more', href: '/about/', variant: 'primary' }];
if (registrationIsOpen) {
  heroActions.unshift({
    variant: 'secondary',
    text: 'Register for Classes',
    href: '/registration/',
    icon: 'tabler:checkbox',
  });
  heroActions[1].variant = 'accent';
}
---

<Layout metadata={metadata}>
  <WidgetWrapper isDark>
    <Fragment slot="bg">
      <div class="absolute inset-0">
        <Image src={hero} alt="Brightstar" class="h-full w-full object-cover object-[50%_15%]" />
      </div>
    </Fragment>
    <Hero actions={heroActions} backdropOverlay="sm">
      <Fragment slot="title">Twin Cities Homeschoolers <br /> for the Arts</Fragment>

      <Fragment slot="subtitle">
        <span class="hidden sm:inline">
          <span class="font-semibold">TCHA</span> exists to provide performing arts classes and opportunities, viewed through
          a redemptive lens, to home educated students in the Minneapolis/St. Paul area.
        </span>
      </Fragment>
    </Hero>
  </WidgetWrapper>

  {featuredEvent && (
    <section class="mx-auto max-w-6xl px-6 py-10 sm:py-14" aria-labelledby="featured-event-heading">
      <article class="overflow-hidden rounded-xl bg-white shadow-lg ring-1 ring-black/5 md:grid md:grid-cols-2 dark:bg-slate-800">
        {featuredEventImage ? (
          <div class="min-h-64 overflow-hidden bg-gray-100 dark:bg-slate-700">
            <SanityImage
              image={featuredEventImage}
              alt={featuredEvent.title}
              mode="cover"
              className="h-full min-h-64 w-full object-cover"
            />
          </div>
        ) : (
          <div class="flex min-h-64 flex-col items-center justify-center bg-primary text-white">
            <span class="text-lg font-semibold uppercase">
              {featuredEvent.dates[0].date.toFormat('MMM')}
            </span>
            <span class="font-heading text-7xl font-bold">{featuredEvent.dates[0].date.toFormat('d')}</span>
          </div>
        )}
        <div class="flex flex-col justify-center gap-4 p-6 sm:p-8">
          <p class="text-primary text-sm font-semibold tracking-wide uppercase">
            {featuredEvent.announcement?.headline || 'Coming up'}
          </p>
          <div>
            <h2
              id="featured-event-heading"
              class="font-heading text-3xl font-bold tracking-tight text-gray-900 dark:text-white"
            >
              {featuredEvent.title}
            </h2>
            {featuredEvent.announcement?.description && (
              <p class="mt-3 text-gray-600 dark:text-gray-300">{featuredEvent.announcement.description}</p>
            )}
          </div>
          <div class="space-y-2 text-sm text-gray-600 dark:text-gray-300">
            <p class="inline-flex items-center gap-2">
              <Icon name="tabler:calendar" class="h-4 w-4 shrink-0" />
              <time datetime={featuredEvent.dates[0].date.toISO() ?? ''}>
                {featuredEvent.dates[0].date.toLocaleString(DateTime.DATETIME_MED_WITH_WEEKDAY)}
              </time>
            </p>
            {featuredEvent.location && (
              <p class="inline-flex items-center gap-2">
                <Icon name="tabler:map-pin" class="h-4 w-4 shrink-0" />
                {featuredEvent.location}
              </p>
            )}
          </div>
          <div class="flex flex-wrap gap-3">
            {featuredEvent.ticket_link && (
              <a class="btn-secondary px-4 py-2" href={featuredEvent.ticket_link}>
                Get Tickets
              </a>
            )}
            {featuredShow && (
              <a class="btn-tertiary px-4 py-2" href={featuredShow.href}>
                View Show Details
              </a>
            )}
            <a class="btn-tertiary px-4 py-2" href="/events/">
              View all events
            </a>
          </div>
        </div>
      </article>
    </section>
  )}

  <Features
    id="features"
    classes={{ headline: { title: 'text-accent dark:text-white text-3xl md:text-4xl' } }}
    title="Education and Performance Opportunities"
    subtitle="We offer a variety of classes in choir, dance, and drama as well as private lessons in several instruments including voice, guitar, and piano. We’re excited to help your student grow and develop their skills in the performing arts!"
    items={[
      {
        title: 'Choir',
        description:
          'Large and small choral ensembles for students K-12 with multiple performances throughout the school year.',
        icon: 'tabler:music',
        implicitAction: '/choir/',
      },
      {
        title: 'Dance',
        description: 'Tap, jazz and ballet',
        icon: 'tabler:flip-flops',
        implicitAction: '/dance/',
      },
      {
        title: 'Drama',
        description:
          'Weekly classes focused on different aspects of theatre including acting, improv, and technical theatre arts.',
        icon: 'tabler:masks-theater',
        implicitAction: '/drama/',
      },
      {
        title: 'Lessons',
        description: 'Vocal and instrumental instructors are available for private lessons.',
        icon: 'tabler:book',
        implicitAction: '/lessons/',
      },
      {
        title: 'Theatre',
        description:
          'Performance opportunities for a variety of age ranges including musical theatre and classic plays',
        icon: 'tabler:theater',
        implicitAction: '/theatre/',
      },
    ]}
  />

  <Testimonials
    title="Words from our community"
    isDark={true}
    testimonials={testimonials.map((t) => ({
      ...t,
      job: t.relationship,
    }))}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'secondary',
        text: 'Donate',
        action: 'givebutter-donate',
        icon: 'tabler:star',
      },
    ]}
  >
    <Fragment slot="title">Will you join us?</Fragment>

    <Fragment slot="subtitle">
      Your donation helps us give your student the opportunity to increase creativity and cultivate proficiency in the
      performing arts.
    </Fragment>
  </CallToAction>

  <Brands
    id="sponsors"
    title="Sponsors"
    subtitle="These businesses and individuals have significantly supported our mission to provide performing arts education and opportunities to home-educated students."
    images={sponsors.map((s) => ({ img: s.logo, alt: s.name, url: s.url }))}
    classes={{}}
  />
</Layout>
