---
import { toHTML } from '@portabletext/to-html';
import { DateTime } from 'luxon';
import type { EventDate } from '../../queries/Events';
import { getPerformanceDateNotes } from '../../utils/performanceNotes';

export interface Props {
  dates: EventDate[];
  idPrefix?: string;
}

const { dates, idPrefix = 'performance' } = Astro.props;

const { performanceDates, footnotes } = getPerformanceDateNotes(dates);

function formatDateTime(date: DateTime): string {
  return date.toLocaleString(DateTime.DATETIME_MED_WITH_WEEKDAY);
}
---

<div class="my-2">
  <ul class="list-disc pl-5">
    {
      performanceDates.map(({ date, marker, index }) => (
        <li id={`${idPrefix}-date-${index}`}>
          <span class="whitespace-nowrap">
            <time datetime={String(date)}>{formatDateTime(date)}</time>
            {marker !== undefined && (
              <sup class="ml-0.5 align-super text-[0.6em] leading-none">
                <a href={`#${idPrefix}-note-${marker}`} aria-label={`See performance note ${marker}`}>
                  {marker}
                </a>
              </sup>
            )}
          </span>
        </li>
      ))
    }
  </ul>
  {
    footnotes.length > 0 && (
      <>
        <h4 class="mt-4 mb-2 text-sm font-semibold dark:text-slate-300">Performance Notes</h4>
        <ol class="list-none space-y-2 pl-0" aria-label="Performance notes">
          {footnotes.map(({ marker, note }) => (
            <li id={`${idPrefix}-note-${marker}`} class="flex gap-2">
              <span aria-hidden="true">{marker}.</span>
              <div class="prose dark:prose-invert max-w-none" set:html={toHTML(note)} />
            </li>
          ))}
        </ol>
      </>
    )
  }
</div>
