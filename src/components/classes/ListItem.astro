---
import { Image } from 'astro:assets';
import { Avatar, Card } from 'flowbite-react';
import listify from 'listify';
import { DateTime } from 'luxon';

import type { ParsedClass } from '../../queries/Classes';
import { urlFor } from '../../queries/sanity';
import { Icon } from 'astro-icon/components';
import { toHTML } from '@portabletext/to-html';
import SanityImage from '../common/SanityImage.astro';
import { findLocalImage } from '../../utils/images';

export interface Props {
  classItem: ParsedClass;
}

const genericClassImage = await findLocalImage('~/assets/images/generic-class.png');
const { classItem } = Astro.props;
---

<article class="mx-auto max-w-md md:max-w-none">
  <Card
    id={'class-' + classItem._id}
    className="max-w-sm"
    imgAlt={classItem.title}
    imgSrc={classItem.preview_image ? urlFor(classItem.preview_image).url() : genericClassImage.src}
  >
    <div>
      <h5 class="mb-4 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
        {classItem.title}
      </h5>
      <span>
        {
          classItem.instructors != null &&
            classItem.instructors.map((instructor) => (
              <div class="flex items-center gap-4">
                <Avatar img={urlFor(instructor.headshot).size(150, 150).url()} size="md" rounded>
                  <div>{instructor.name}</div>
                  <div class="text-xs text-gray-500 dark:text-gray-400">{listify(instructor.class_types)}</div>
                </Avatar>
              </div>
            ))
        }
      </span>
      {
        classItem.classTimes?.start && (
          <div class="mt-3 mb-0">
            <span class="text-sm">
              <Icon
                title="Class Times"
                name="tabler:clock"
                class="-mt-0.5 inline-block h-3.5 w-3.5 dark:text-gray-400"
              />
              <time datetime={`${classItem.classTimes.start}/${classItem.classTimes.end}`} class="inline-block">
                {classItem.classTimes.start} - {classItem.classTimes.end}
              </time>
            </span>
          </div>
        )
      }
      {
        classItem.dates && (
          <div class="mt-0.5 mb-0">
            <span class="text-sm">
              <Icon
                title="Schedule"
                name="tabler:calendar"
                class="-mt-0.5 inline-block h-3.5 w-3.5 dark:text-gray-400"
              />
              <span>{classItem.dates}</span>
            </span>
          </div>
        )
      }
      <div class="mt-0.5 mb-0">
        <span class="text-sm" title={'Ages ' + classItem.ages.min + '-' + classItem.ages.max}>
          <Icon title="Grades" name="tabler:school" class="-mt-0.5 inline-block h-3.5 w-3.5 dark:text-gray-400" />
          {classItem.grades.min} - {classItem.grades.max}
        </span>
      </div>
      <div class="mt-0.5">
        <span class="text-sm">
          <Icon
            title="Tuition Fee"
            name="tabler:currency-dollar"
            class="-mt-0.5 inline-block h-3.5 w-3.5 dark:text-gray-400"
          />
          <span class:list={{ 'text-gray-500 line-through dark:text-gray-400': classItem.isEarlyRegistration }}
            >{classItem.price}</span
          >
          {classItem.isEarlyRegistration && <>{classItem.price - classItem.early_registration_discount}</>}
        </span>
      </div>
      {
        classItem.isOpenForRegistration && classItem.registrationLink && (
          <a
            class="btn-secondary text-primary hover:bg-darkMode focus:bg-darkMode mt-4 inline-flex items-center gap-x-1 rounded-lg px-3 py-2 text-center text-sm font-medium hover:text-white focus:text-white focus:ring-4 focus:outline-none"
            href={classItem.registrationLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            Register
          </a>
        )
      }
      <button
        id={'class-' + classItem._id + '-button'}
        data-drawer-target={'class-' + classItem._id + '-drawer'}
        data-drawer-show={'class-' + classItem._id + '-drawer'}
        data-drawer-placement="right"
        aria-controls={'class-' + classItem._id + '-drawer'}
        class="btn-accent mt-4 inline-flex items-center gap-x-1 rounded-lg px-3 py-2 text-center text-sm font-medium text-white focus:ring-4 focus:outline-none"
      >
        Read more <Icon name="tabler:arrow-right" />
      </button>
      {
        (classItem.isEarlyRegistration || classItem.isOpenForRegistration) && (
          <div class="text-muted text-sm italic">
            {classItem.isOpenForRegistration && (
              <>Registration closes {classItem.registration_close.toLocaleString(DateTime.DATE_MED)}</>
            )}
            {classItem.isEarlyRegistration && (
              <>
                Early registration discount expires{' '}
                {classItem.early_registration_end!.toLocaleString(DateTime.DATE_MED)}
              </>
            )}
          </div>
        )
      }
    </div>
  </Card>

  <div
    id={'class-' + classItem._id + '-drawer'}
    class="fixed top-24 right-0 bottom-0 z-40 w-full max-w-2xl translate-x-full p-3 pt-1 transition-transform"
    tabindex="-1"
    aria-labelledby="drawer-right-label"
  >
    <div
      class="h-full overflow-y-auto rounded-md border-l border-gray-200 bg-white/95 p-4 shadow-2xl backdrop-blur dark:border-gray-700 dark:bg-gray-800/95"
    >
      <div class="mb-3 flex items-center justify-between">
        <h3
          id={'class-' + classItem._id + '-label'}
          class="mb-0 inline-flex items-center text-3xl font-semibold dark:text-white"
        >
          {classItem.title}
        </h3>
        <button
          type="button"
          data-drawer-hide={'class-' + classItem._id + '-drawer'}
          aria-controls={'class-' + classItem._id + '-drawer'}
          class="absolute end-2.5 top-2.5 inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gray-200 text-sm text-gray-600 hover:bg-gray-300 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600"
        >
          <Icon name="tabler:x" />
          <span class="sr-only">Close drawer</span>
        </button>
      </div>
      {
        classItem.preview_image ? (
          <SanityImage image={classItem.preview_image} />
        ) : (
          <Image src={genericClassImage} alt={classItem.title} />
        )
      }
      <div>
        {
          classItem.isOpenForRegistration && classItem.registrationLink && (
            <button
              type="button"
              class="me-2 mt-4 mb-2 w-full rounded-lg bg-green-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-green-800 focus:ring-4 focus:ring-green-300 focus:outline-none dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800"
              onclick={`window.open('${classItem.registrationLink}', '_blank').focus()`}
            >
              Register
            </button>
          )
        }
      </div>
      <div class="mt-3 mb-2 flex flex-wrap gap-x-4">
        {
          classItem.dates && (
            <div class="basis-full">
              <span class="text-sm">
                <Icon
                  title="Schedule"
                  name="tabler:calendar"
                  class="-mt-0.5 inline-block h-3.5 w-3.5 dark:text-gray-400"
                />
                <span>{classItem.dates}</span>
              </span>
            </div>
          )
        }
        {
          classItem.classTimes?.start && (
            <div>
              <span class="text-sm">
                <Icon
                  title="Class Times"
                  name="tabler:clock"
                  class="-mt-0.5 inline-block h-3.5 w-3.5 dark:text-gray-400"
                />
                <time datetime={`${classItem.classTimes.start}/${classItem.classTimes.end}`} class="inline-block">
                  {classItem.classTimes.start} - {classItem.classTimes.end}
                </time>
              </span>
            </div>
          )
        }
        <div>
          <span class="text-sm" title={'Ages ' + classItem.ages.min + '-' + classItem.ages.max}>
            <Icon title="Grades" name="tabler:school" class="-mt-0.5 inline-block h-3.5 w-3.5 dark:text-gray-400" />
            {classItem.grades.min} - {classItem.grades.max}
          </span>
        </div>
        <div>
          <span class="text-sm">
            <Icon
              title="Tuition Fee"
              name="tabler:currency-dollar"
              class="-mt-0.5 inline-block h-3.5 w-3.5 dark:text-gray-400"
            />
            <span class:list={{ 'text-gray-500 line-through dark:text-gray-400': classItem.isEarlyRegistration }}
              >{classItem.price}</span
            >
            {classItem.isEarlyRegistration && <>{classItem.price - classItem.early_registration_discount}</>}
          </span>
        </div>
      </div>
      <div class="prose dark:prose-invert max-w-none" set:html={toHTML(classItem.description)} />
      <h4
        id={'class-' + classItem._id + '-instructor-heading'}
        class="mt-4 mb-4 inline-flex items-center text-xl font-semibold dark:text-white"
      >
        Instructor{classItem.instructors.length !== 1 ? 's' : ''}
      </h4>
      <div class="flex flex-wrap items-start gap-6">
        {
          classItem.instructors != null &&
            classItem.instructors.map((instructor) => (
              <>
                <SanityImage image={instructor.headshot} alt={instructor.name} className="shrink-0 grow-0 basis-40" />
                <div class="shrink grow basis-80">
                  <h5 class="font-semibold">{instructor.name}</h5>
                  <div class="text-xs text-gray-500 dark:text-gray-400">{listify(instructor.class_types)}</div>
                  <div class="mt-2 flex flex-col gap-2" set:html={toHTML(instructor.bio)} />
                </div>
              </>
            ))
        }
      </div>
    </div>
  </div>
</article>
