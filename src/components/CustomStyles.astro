---
import '@fontsource-variable/josefin-sans';
import '@fontsource/lato';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline is:global>
  :root {
    --aw-font-sans: 'Lato';
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: 'Josefin Sans Variable';

    --aw-color-primary: rgb(51 84 109);
    --aw-color-secondary: rgb(255 201 96);
    --aw-color-accent: rgb(241 72 91);

    --aw-color-text-heading: var(--aw-color-text-default);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);

    ::selection {
      background-color: lavender;
    }
    --fc-classic-background: rgb(255 255 255);
  }

  .dark {
    --aw-font-sans: 'Lato';
    --aw-font-serif: var(--aw-font-sans);
    --aw-font-heading: 'Josefin Sans Variable';

    --aw-color-primary: rgb(51 84 109);
    --aw-color-secondary: rgb(255 201 96);
    --aw-color-accent: rgb(215, 65, 83);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: var(--aw-color-bg-page-dark);

    ::selection {
      background-color: black;
      color: snow;
    }

    --fc-classic-background: rgb(3 6 32);
    --fc-classic-muted: rgb(20 27 45);
  }

  html .tcha-calendar-toolbar-title {
    font-size: 1.75em;
  }

  html .tcha-calendar-button,
  html .tcha-calendar-day-header-inner,
  html .tcha-calendar-date-number {
    font-size: inherit;
  }

  html .tcha-calendar-icon-only-button {
    min-height: calc(1.5em + 18px);
  }

  html .tcha-calendar-event {
    font-size: 0.65em;
  }

  html .tcha-calendar-event-inner {
    font-size: inherit;
  }

  html .tcha-calendar-more-link-inner {
    font-size: 0.65em;
  }

  html .tcha-calendar {
    font-size: inherit;
  }

  .tcha-calendar-day-header {
    font-weight: 700;
  }
  /* --aw-color-accent: rgb(194, 61, 76); */
</style>
